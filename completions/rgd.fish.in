# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_rgd_global_optspecs
    string join \n h/help V/version
end

function __fish_rgd_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_rgd_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_rgd_using_subcommand
    set -l cmd (__fish_rgd_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c rgd -n "__fish_rgd_needs_command" -s h -l help -d 'Print help'
complete -c rgd -n "__fish_rgd_needs_command" -s V -l version -d 'Print version'
complete -c rgd -n "__fish_rgd_needs_command" -f -a "list" -d 'List details of detected games and custom entries'
complete -c rgd -n "__fish_rgd_needs_command" -f -a "get" -d 'Get details of a specific game or custom entry'
complete -c rgd -n "__fish_rgd_needs_command" -f -a "completion" -d 'Generate shell completions for supported shells'
complete -c rgd -n "__fish_rgd_needs_command" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
complete -c rgd -n "__fish_rgd_using_subcommand list" -s s -l source -d 'Specify the source (launcher) for which to list games from' -r -f -a "steam\t''
lutris\t''
bottles\t''
heroic\t''
prism\t''
at\t''
itch\t''
faugus\t''"
complete -c rgd -n "__fish_rgd_using_subcommand list" -s d -l delimiter -d 'Delimiter used to separate detail columns (Default: \\t)' -r
complete -c rgd -n "__fish_rgd_using_subcommand list" -s f -l fields -d 'Fields (details about the game) which will be included in the final output' -r -f -a "title\t''
path-icon\t''
path-box-art\t''
path-game-dir\t''
path-hero\t''
path-header\t''
launch-command\t''
source\t''"
complete -c rgd -n "__fish_rgd_using_subcommand list" -s j -l json -d 'Output details in JSON format'
complete -c rgd -n "__fish_rgd_using_subcommand list" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c rgd -n "__fish_rgd_using_subcommand get" -s d -l delimiter -d 'Delimiter used to separate detail columns (Default: \\t)' -r
complete -c rgd -n "__fish_rgd_using_subcommand get" -s f -l fields -d 'Fields (details about the game) which will be included in the final output' -r -f -a "title\t''
path-icon\t''
path-box-art\t''
path-game-dir\t''
path-hero\t''
path-header\t''
launch-command\t''
source\t''"
complete -c rgd -n "__fish_rgd_using_subcommand get" -s j -l json -d 'Output details in JSON format'
complete -c rgd -n "__fish_rgd_using_subcommand get" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c rgd -n "__fish_rgd_using_subcommand completion" -s h -l help -d 'Print help'
complete -c rgd -n "__fish_rgd_using_subcommand help; and not __fish_seen_subcommand_from list get completion help" -f -a "list" -d 'List details of detected games and custom entries'
complete -c rgd -n "__fish_rgd_using_subcommand help; and not __fish_seen_subcommand_from list get completion help" -f -a "get" -d 'Get details of a specific game or custom entry'
complete -c rgd -n "__fish_rgd_using_subcommand help; and not __fish_seen_subcommand_from list get completion help" -f -a "completion" -d 'Generate shell completions for supported shells'
complete -c rgd -n "__fish_rgd_using_subcommand help; and not __fish_seen_subcommand_from list get completion help" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
